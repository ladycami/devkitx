# Copy to .env (gitignored, never commit it) and fill in, then: chmod 600 .env
# Used by scripts/publish.py for local uploads. CI releases need no token:
# they use PyPI trusted publishing (.github/workflows/release.yml).
#
# Create project-scoped tokens at https://pypi.org/manage/account/token/
# and https://test.pypi.org/manage/account/token/
PYPI_USERNAME=__token__
PYPI_TOKEN=
TEST_PYPI_TOKEN=
